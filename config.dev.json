{
  "_comment": "GoMail Configuration — all settings for your mail server DEVELOPMENT",

  "server": {
    "hostname": "mail.example.com",
    "domain": "example.com"
  },

  "smtp": {
    "listen_addr": ":25",
    "max_message_size": 26214400,
    "max_recipients": 100,
    "read_timeout": 60,
    "write_timeout": 60,
    "max_connections": 100,
    "ratelimit": {
      "connections_per_minute": 30,
      "messages_per_minute": 10
    }
  },

  "mail_clients": {
    "enabled": false,
    "read_timeout": 60,
    "write_timeout": 60,
    "max_connections": 50,
    "auth_attempts_per_minute": 10,
    "imap": {
      "enabled": false,
      "listen_addr": ":993"
    },
    "pop3": {
      "enabled": true,
      "listen_addr": ":995"
    },
    "submission": {
      "enabled": true,
      "listen_addr": ":587"
    }
  },

  "tls": {
    "mode": "autocert",
    "cert_file": "",
    "key_file": "",
    "acme_email": "admin@example.com",
    "acme_dir": "./data/certs",
    "min_version": "1.2"
  },

  "dkim": {
    "default_selector": "mail",
    "default_algorithm": "ed25519"
  },

  "store": {
    "db_path": "./data/mail.db",
    "attachments_path": "./data/attachments"
  },

  "web": {
    "listen_addr": ":443",
    "http_addr": ":80",
    "enable_tls": true,
    "session_secret": "change-me-to-a-random-64-char-string",
    "session_max_age": 86400,
    "rate_limit_per_minute": 5,
    "trusted_proxies": [],
    "external_https": false,
    "bootstrap_admin": {
      "email": "admin@example.com",
      "password_hash": ""
    }
  },

  "delivery": {
    "queue_workers": 4,
    "retry_intervals": [1800, 3600, 7200, 14400, 28800, 43200, 86400, 86400, 86400, 86400],
    "max_retries": 11,
    "dsn_delay_after_seconds": 14400,
    "network": "tcp",
    "enable_verp": false
  },

  "dns": {
    "cache_ttl": 300
  },

  "security": {
    "csrf_key": "change-me-to-another-random-32-char-string",
    "auth_enforcement": "observe",
    "quarantine_folder": "Spam"
  },

  "mail": {
    "strip_originating_ip": false
  },

  "mdn": {
    "enabled": "yes",
    "mode": "auto"
  },

  "logging": {
    "level": "info",
    "format": "text"
  },

  "metrics": {
    "enabled": false,
    "listen_addr": "127.0.0.1:9090",
    "bearer_token": ""
  },
  "storage_pressure": {
    "warning_free_bytes": 2147483648,
    "minimum_free_bytes": 1073741824
  },
  "outbound_limits": {
    "enabled": true,
    "messages_per_hour": 100,
    "messages_per_day": 500,
    "recipients_per_hour": 250,
    "recipients_per_day": 1000,
    "max_recipients_per_message": 100,
    "suspension_minutes": 60
  },

  "dmarc": {
    "send_reports": false
  }

}
